# Copy to .env.local and fill in. Never commit real values.

# Base URL of the RevoTask API, without a trailing slash.
# Used in the browser by Client Components (must start with NEXT_PUBLIC_).
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Same API, as reached from the Next.js server by Server Components.
API_BASE_URL=http://localhost:5000
