# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection for the app. In production: Neon's pooled connection string.
# Both postgres:// and postgresql:// schemes are accepted.
DATABASE_URL=postgresql://user:password@localhost:5432/revotask_dev

# Separate PostgreSQL database used only by pytest. Its tables are wiped on every test run.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/revotask_test

# Flask session signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-string

# JWT signing key. Use a different random value from SECRET_KEY.
JWT_SECRET_KEY=replace-with-another-random-64-character-hex-string

# Comma-separated list of allowed browser origins (no trailing slash).
CORS_ORIGINS=http://localhost:3000

# "development" enables debug mode; use "production" on Vercel.
FLASK_ENV=development

# --- Production setup: Vercel (API) + Neon (PostgreSQL), one time ---
# 1. Neon: create a project and copy its *pooled* connection string.
# 2. Vercel: create a project for the "backend" folder (`npx vercel link` inside it).
#    Vercel detects Flask from requirements.txt and the `app` in wsgi.py.
# 3. Set DATABASE_URL (the Neon string), SECRET_KEY, JWT_SECRET_KEY, CORS_ORIGINS and
#    FLASK_ENV=production as Vercel environment variables. TEST_DATABASE_URL is not needed there.
# 4. Deploy with `npx vercel --prod`. Every deploy runs `flask db upgrade` first (see vercel.json), so migrations are applied.
# 5. After the frontend is deployed, put its URL in CORS_ORIGINS and redeploy.
